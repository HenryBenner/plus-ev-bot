# Required: Prediction Hunt Dev, Pro, or Enterprise API key.
PREDICTION_HUNT_API_KEY=pmx_replace_me

# Paper-trading behavior.
TRADING_MODE=paper
PAPER_STAKE_USD=10.00
MAX_EVENT_HOURS=72
MAX_PRICE_DRIFT=0.10

# Live mode is ignored while TRADING_MODE=paper. Keep these blank for paper.
# Enabling live orders requires all fields plus the exact two safety values.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_ACK=
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=
LIVE_SHARES_PER_TRADE=10
# Empty means allow all. Examples: sports,crypto or sports
LIVE_CATEGORY_FILTERS=sports
# Empty means allow all. Use team_winner for sports moneyline/winner markets.
LIVE_MARKET_TYPE_FILTERS=team_winner

# Storage.
DATABASE_PATH=data/fade_finder.db

# Polling and API endpoints. Defaults normally do not need changing.
SETTLEMENT_POLL_SECONDS=900
API_READ_TIMEOUT_SECONDS=45
WEBSOCKET_OPEN_TIMEOUT_SECONDS=60
PREDICTION_HUNT_WS_URL=wss://ws.predictionhunt.com
POLYMARKET_US_GATEWAY_URL=https://gateway.polymarket.us
POLYMARKET_US_API_URL=https://api.polymarket.us
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
LOG_LEVEL=INFO
